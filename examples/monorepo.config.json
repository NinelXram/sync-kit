      ],
      "fe": [
        "packages/ui/src/index.ts"
      ]
    }
  },
  "strict": { "enabled": true, "since": "2026-10-29" },
  "notify": {
    "channel": "telegram",
    "managers": {
      "be": ["@alice"],
      "fe": ["@bob"],
      "qa": ["@carol"]
    },
