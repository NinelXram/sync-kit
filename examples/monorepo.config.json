{
  "kitVersion": "1.0.0",
  "lang": "en",
  "topology": "monorepo",
  "sides": {
    "be": "Backend",
    "fe": "Web",
    "mobile": "Mobile",
    "qa": "QA"
  },
  "paused": ["mobile"],
  "modules": {
    "billing": "billing",
    "orders": "orders",
    "accounts": "accounts"
  },
  "inbox": { "commit": true },
  "contract": {
    "globs": {
      "be": [
        "apps/api/openapi.yaml",
